# ===== 构建产物 =====
# 前端/移动端构建产物勿入库（体积大、导致远端超限）；部署时在目标环境执行构建。
riveredge-frontend/dist/
riveredge-mobile/dist/
# riveredge-frontend/static/ 允许提交，含 social 图标等静态资源，生产环境需拉取
riveredge-frontend/.vite/
*.log
.logs/

# ===== 环境与密钥 =====
.env
.env.local
.env.*.local
*.pem

# ===== 运行时/缓存 =====
riveredge-backend/uploads/
riveredge-backend/backups/
*.sqlite
*.db

# ===== IDE / Agent 本地产物 =====
.agent/
.cursor/
# CI：工作流在团队仓库中不跟踪（本地可自建 .github/workflows）
.github/workflows/
# .vscode/ 已排除，推送到远程仓库供团队共享配置
nul
*.swp
*.swo
.DS_Store

# ===== 本地/部署（不推送） =====
# 移动端独立维护，不随主仓推送（本地保留 riveredge-mobile/）
riveredge-mobile/
# 闭源客户端（移动 App / 工位机），独立仓库或本地维护，不纳入主仓
riveredge-app-mobile/
riveredge-app-station/
# 本地构建发布脚本（各人自选保留，不提交）
build-web.sh

bin/
deploy/
scripts/
# 根目录 scripts/ 会忽略各子项目下的 scripts/；必须保留以下两条，否则 riveredge-panel/scripts/ 无法提交
!riveredge-panel/scripts/
!riveredge-panel/scripts/**
!riveredge-frontend/scripts/
# 前端业务页：infra 脚本管理（勿被根目录 scripts/ 规则误伤）
!riveredge-frontend/src/pages/infra/scripts/
!riveredge-frontend/src/pages/infra/scripts/**
riveredge-panel/diagnose.sh
riveredge-panel/fix-and-start.sh

# ===== 后端脚本与测试（不推送） =====
riveredge-backend/scripts/
riveredge-backend/tests/
!riveredge-backend/tests/
!riveredge-backend/tests/config_gates/
!riveredge-backend/tests/config_gates/**
riveredge-backend/tests/config_gates/__pycache__/
riveredge-backend/tests/config_gates/**/*.pyc

# ===== 测试 =====
.coverage
htmlcov/
.pytest_cache/
.tox/

# ===== 审计报告（本地保留，Git 忽略） =====
docs/optimize/
