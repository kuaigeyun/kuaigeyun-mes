# RiverEdge SaaS 多组织框架 - 后端环境变量配置示例
# 
# 使用方法：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 根据实际环境修改配置值
# 3. .env 文件已加入 .gitignore，不会被提交到版本库

# ========================================
# 应用配置
# ========================================
APP_NAME=RiverEdge SaaS Framework
APP_VERSION=1.0.0
# 发版/部署可注入，供 /api/v1/infra/platform/version 返回短 commit 与部署时间（fast-deploy update/向导写入）
# GIT_SHA= 或全长 commit；PLATFORM_GIT_SHA 为兼容别名
# PLATFORM_BUILD_TIME=2026-01-01T00:00:00Z
DEBUG=false
ENVIRONMENT=development

# ========================================
# 服务器配置
# ========================================
# 后端服务主机地址（Windows 使用 127.0.0.1，Linux/Mac 使用 0.0.0.0）
# 手机端/内网调试时需设为 0.0.0.0，否则手机无法连接
HOST=127.0.0.1
# 后端服务端口（避免与系统保留端口和主流项目常用端口冲突）
PORT=8200

# ========================================
# API 文档访问控制（ReDoc / OpenAPI）
# ========================================
# 同时设置用户名与密码后，/redoc、/openapi.json（及将来若开启的 /docs）需浏览器 Basic 登录。
# 留空或不完整配置则文档仍可匿名访问（便于本地开发）。
# DOCS_BASIC_AUTH_USER=admin
# DOCS_BASIC_AUTH_PASSWORD=change-me
# ReDoc 首屏加速：默认 false=不加载 Google Fonts（国内常见卡顿来源）；true=使用原版字体样式
# REDOC_USE_GOOGLE_FONTS=false
# 默认同源 /static/redoc/redoc.standalone.js（文件在 src/server/doc_assets/redoc，不经仓库根目录）；可改 CDN：
# REDOC_JS_URL=https://cdn.jsdelivr.net/npm/redoc@2/bundles/redoc.standalone.js

# ========================================
# 前端服务配置（用于 CORS 配置）
# ========================================
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8100

# ========================================
# 异步任务配置
# ========================================
# 异步任务由 Taskiq + PostgreSQL 承担，无需额外服务变量
# 仅需正确配置下方 DB_* 即可

# ========================================
# 数据库配置 (PostgreSQL)
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=riveredge

# PostgreSQL 连接池（多进程：API + Worker + Scheduler 各占一套，远程库 max_connections 有限时需调小）
# RIVEREDGE_DB_POOL_MIN=2
# RIVEREDGE_DB_POOL_MAX=10
# RIVEREDGE_TASKIQ_POOL_MIN=1
# RIVEREDGE_TASKIQ_POOL_MAX=3

# ========================================
# JWT 配置
# ========================================
# ⚠️ 重要：生产环境必须修改此密钥
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# CORS 配置
# ========================================
# CORS 允许的来源（多个值用逗号分隔，如果不设置则自动从前端配置生成）
# CORS_ORIGINS=http://127.0.0.1:8100,http://localhost:8100
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=INFO
LOG_FILE=logs/riveredge.log

# ========================================
# 时区配置
# ========================================
USE_TZ=false
TIMEZONE=UTC

# ========================================
# 平台超级管理员配置
# ========================================
PLATFORM_SUPERADMIN_USERNAME=infra_admin
# ⚠️ 重要：生产环境必须设置强密码
PLATFORM_SUPERADMIN_PASSWORD=
PLATFORM_SUPERADMIN_EMAIL=infra_admin@riveredge.cn
PLATFORM_SUPERADMIN_FULL_NAME=平台超级管理员

# ========================================
# 应用 manifest 目录（生产环境）
# ========================================
# 默认扫描 riveredge-backend/src/apps，manifest 以后端为单一来源
# 若部署结构不同可覆盖此变量
# APPS_MANIFEST_DIR=/path/to/apps

# ========================================
# 部署版本时间（生产环境由部署面板自动写入）
# ========================================
# 当前部署版本构建时间，用于右下角版本信息展示。格式：ISO 8601（如 2026-03-08T08:01:00Z）
# 部署面板在 build 步骤完成时会自动写入，无需手动配置
# PLATFORM_BUILD_TIME=

# ========================================
# 文件管理配置
# ========================================
FILE_UPLOAD_DIR=./uploads
# 数据备份 zip 目录（留空则使用 {后端根目录}/backups）
# DATA_BACKUP_DIR=./backups
MAX_FILE_SIZE=104857600
# 基础URL（用于生成文件/图片链接）。生产环境有域名时必须设置，否则图片加载失败
# 示例：BASE_URL=https://kuaigeyun.com  或  BASE_URL=http://192.168.1.100:8200
BASE_URL=

# ========================================
# 移动端推送（好力 GO 锁屏通知）
# 默认 FCM；若仍用极光可设 PUSH_PROVIDER=jpush
# ========================================
PUSH_ENABLED=true
PUSH_PROVIDER=fcm
# FCM：Firebase 控制台下载的服务账号 JSON 文件路径，或内联 JSON
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=/path/to/firebase-service-account.json
# 极光（PUSH_PROVIDER=jpush 时）：
# JPUSH_APP_KEY=
# JPUSH_MASTER_SECRET=
