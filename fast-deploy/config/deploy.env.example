# RiverEdge fast-deploy 部署层配置
# 复制为 deploy.env 后按需修改：cp config/deploy.env.example config/deploy.env

# 后端 API 端口（Caddy 反代目标）
BACKEND_PORT=8200

# 蓝绿部署（update 时交互选择，默认传统；BLUE_GREEN_DEPLOY=1 可强制 start/stop 走双槽位）
# UPDATE_BLUE_GREEN=0|1 非交互 update 时跳过询问（未设置时默认传统）
BLUE_GREEN_DEPLOY=0
BACKEND_PORT_BLUE=8201
BACKEND_PORT_GREEN=8202
WORKER_DRAIN_TIMEOUT=60
BLUE_GREEN_HEALTH_TIMEOUT=120

# 前端开发端口（仅 dev 模式）
FRONTEND_PORT=8100

# Caddy 对外监听端口（生产模式，无域名时监听 :PROXY_PORT）
PROXY_PORT=8080

# 生产域名（向导/configure 可写入；留空则使用 IP + :PROXY_PORT）
# HTTPS 启用时 Caddy 自动为 apex 与 www 申请证书（例如 kuaigeyun.com + www.kuaigeyun.com）
CADDY_DOMAIN=

# 是否启用 Let's Encrypt（填写域名后向导默认可开启；需 DNS 指向本机且 80 端口公网可达）
CADDY_ENABLE_LETSENCRYPT=false

# Caddy TLS/配置数据目录（固定于项目内，避免 root/ubuntu 用户切换导致证书丢失）
# CADDY_DATA_DIR=
# CADDY_CONFIG_DIR=
# Caddy 启动后等待监听端口的秒数（HTTPS 首次申请证书可能较慢）
# CADDY_START_TIMEOUT=45

# Node 构建堆内存（MB，仅 ALLOW_SERVER_BUILD=1 或 deploy.sh build 时使用）
NODE_BUILD_MEM=4096

# 生产 update 默认使用 Git 中的 riveredge-frontend/dist，不在服务器构建（弱机友好）。
# 设为 1 时 update/build 会在服务器执行 npm run build（内存占用高，易 OOM）。
# ALLOW_SERVER_BUILD=0

# 低配模式（向导 [9] 或 deploy.sh low-spec-mode on|off；小内存机自动调低 Taskiq/连接池并禁用蓝绿双后端）
# LOW_SPEC_MODE=0

# Taskiq worker 子进程数（taskiq CLI 默认为 2，每子进程约 +200MB；生产建议 1）
TASKIQ_WORKERS=1

# Taskiq worker/scheduler 启动就绪等待秒数（低内存机 import 慢，默认 180）
# TASKIQ_START_TIMEOUT=180

# 服务器 IP（configure 向导写入，用于 BASE_URL 与局域网访问提示）
SERVER_IP=

# 生产 update 同步分支（默认 develop；执行 fetch + checkout -B origin/<branch>，无需手动 git pull）
# 主仓更新（向导 [3] / deploy.sh update）等价于:
#   git fetch <GIT_REMOTE> && git reset --hard <GIT_REMOTE>/<GIT_BRANCH>
# GIT_BRANCH=develop
# GIT_REMOTE=origin
# 更新时清理未跟踪文件（生产默认启用；1=启用 0=禁用；保留 .env/uploads/.logs 等）
# GIT_CLEAN_ON_UPDATE=1

# ----- 扩展应用 / 终端仓（仅菜单 [4] / deploy.sh pro-apps|install-h5；不随 update）-----
# ENABLED=1 表示已配置可安装；专业/定制会 sync+compose，终端仓仅 clone/pull
# 分支约定：主仓 / 专业包 / 定制包 / 终端仓一律 develop（禁止配置 main）
# PRO_ENABLED=0
# PRO_REPO_URL=https://gitee.com/kuaigeyun/kuaigeyun-pro.git
# PRO_REPO_PATH=
# PRO_GIT_BRANCH=develop
# PRO_GIT_TOKEN=
# WORKSPACE_COMPOSE_MODE=copy
# CUSTOM_ENABLED=0
# CUSTOM_REPO_URL=https://gitee.com/kuaigeyun/kuaigeyun-custom.git
# CUSTOM_REPO_PATH=
# CUSTOM_GIT_BRANCH=develop
# CUSTOM_GIT_TOKEN=
# CLIENT_ENABLED=0
# CLIENT_REPO_URL=https://gitee.com/kuaigeyun/kuaigeyun-client.git
# CLIENT_REPO_PATH=
# CLIENT_GIT_BRANCH=develop
# CLIENT_GIT_TOKEN=

# Playwright Chromium 后台补装（0=跳过；PDF 打印需 Chromium，补装进度见 .logs/playwright-install.log）
PLAYWRIGHT_POSTINSTALL_ENABLE=1

# Chromium 浏览器二进制目录（默认项目根 .playwright-browsers，避免 ~/.cache 被清理或 sudo/用户不一致导致丢失）
# PLAYWRIGHT_BROWSERS_PATH=

# 国内 PyPI（USE_MIRROR=1 时 uv 默认阿里云）。清华 tuna 在部分 Windows 上会 Connect 超时。
# UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 客户端安装包/OTA 静态文件根目录（Caddy 直出；默认 riveredge-backend/uploads/clients）
# CLIENT_RELEASE_ROOT=
# 后端 FILE_UPLOAD_DIR 对应目录（遗留 mobile-apk 直出；默认 CLIENT_RELEASE_ROOT 的上级 uploads）
# FILE_UPLOAD_ROOT=
