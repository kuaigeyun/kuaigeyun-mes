# RiverEdge fast-deploy 部署层配置
# 复制为 deploy.env 后按需修改：cp config/deploy.env.example config/deploy.env

# systemd 开机自启运行用户（非 root；留空则按 SUDO_USER → 当前用户 → 项目目录属主推断）
# SERVICE_USER=your-deploy-user

# 后端 API 端口（Caddy 反代目标）
BACKEND_PORT=8200

# 蓝绿部署（update 时交互选择，默认传统；BLUE_GREEN_DEPLOY=1 可强制 start/stop 走双槽位）
# UPDATE_BLUE_GREEN=0|1 非交互 update 时跳过询问（未设置时默认传统）
BLUE_GREEN_DEPLOY=0
BACKEND_PORT_BLUE=8201
BACKEND_PORT_GREEN=8202
WORKER_DRAIN_TIMEOUT=60
BLUE_GREEN_HEALTH_TIMEOUT=120

# 前端开发端口（仅 dev 模式）
FRONTEND_PORT=8100

# Caddy 对外监听端口（生产模式，无域名时监听 :PROXY_PORT）
PROXY_PORT=8080

# 生产域名（向导/configure 可写入；留空则使用 IP + :PROXY_PORT）
# HTTPS 启用时 Caddy 自动为 apex 与 www 申请证书（例如 kuaigeyun.com + www.kuaigeyun.com）
CADDY_DOMAIN=

# 是否启用 Let's Encrypt（填写域名后向导默认可开启；需 DNS 指向本机且 80 端口公网可达）
CADDY_ENABLE_LETSENCRYPT=false

# 额外反向代理（与本项目主站并列的独立站点块；start/reload 时写入 Caddyfile）
# 格式：站点->上游host:port，多条用逗号分隔
#   http://app.example.com->192.168.1.10:8888                 # 仅 HTTP
#   other.example.com->192.168.1.20:80                        # 裸域名 = 自动 HTTPS（需 80/443 可达）
# 也可用列表文件（每行一条，支持 # 注释）：config/caddy-extra-proxies.list
# 示例见 config/caddy-extra-proxies.list.example
# CADDY_EXTRA_PROXIES=http://app.example.com->192.168.1.10:8888
# CADDY_EXTRA_PROXIES_FILE=

# Caddy TLS/配置数据目录（固定于项目内，避免 root/ubuntu 用户切换导致证书丢失）
# CADDY_DATA_DIR=
# CADDY_CONFIG_DIR=
# Caddy 启动后等待监听端口的秒数（HTTPS 首次申请证书可能较慢）
# CADDY_START_TIMEOUT=45

# Node 构建堆内存（MB，仅 ALLOW_SERVER_BUILD=1 或 deploy.sh build 时使用）
NODE_BUILD_MEM=4096

# 生产 update 默认使用 Git 中的 riveredge-frontend/dist，不在服务器构建（弱机友好）。
# build.web.sh 发布时会在 Git 历史仅保留 tip 一份 dist（git filter-repo），避免仓库体积膨胀。
# 设为 1 时 update/build 会在服务器执行 npm run build（内存占用高，易 OOM）。
# ALLOW_SERVER_BUILD=0

# 低配模式（向导 [9] 或 deploy.sh low-spec-mode on|off；小内存机自动调低 Taskiq/连接池并禁用蓝绿双后端）
# 低配不影响 Chromium；打印 PDF 由 OPT_PDF_PRINT=1 控制（开启即补装浏览器）
# LOW_SPEC_MODE=0

# 后端冷启动等待 /health 秒数（默认 prod 180 / dev 120；蓝绿切槽时 lifespan 注册全应用路由前 /health 不通）
# BACKEND_START_TIMEOUT=180

# Linux 小内存机 Swap（低配模式开启或物理内存 ≤5GB 且 start 时无 swap 则自动创建；需 root/sudo）
# SWAP_AUTO_ENABLE=1
# SWAP_FILE=/swapfile
# SWAP_SIZE_GB=4
# VM_SWAPPINESS=10

# 后端 .env：DOCS_ENABLED=false 可关闭 ReDoc/OpenAPI 预热，节省约 MB 级常驻内存（低配模式自动关闭）

# Taskiq worker 子进程数（taskiq CLI 默认为 2，每子进程约 +200MB；生产建议 1）
TASKIQ_WORKERS=1

# Taskiq worker/scheduler 启动就绪等待秒数（低内存机 import 慢，默认 180）
# TASKIQ_START_TIMEOUT=180

# 服务器 IP（configure 向导写入，用于 BASE_URL 与局域网访问提示）
SERVER_IP=

# 生产 update 同步分支（默认 develop；执行 fetch + checkout -B origin/<branch>，无需手动 git pull）
# 主仓更新（向导 [3] / deploy.sh update）等价于:
#   git fetch <GIT_REMOTE> && git reset --hard <GIT_REMOTE>/<GIT_BRANCH>
# GIT_BRANCH=develop
# GIT_REMOTE=origin
# 更新时清理未跟踪文件（生产默认启用；1=启用 0=禁用；保留 .env/uploads/.logs 等）
# GIT_CLEAN_ON_UPDATE=1

# ----- 扩展应用 / 终端仓（仅菜单 [4] / deploy.sh pro-apps|install-h5；不随 update）-----
# ENABLED=1 表示已配置可安装；专业/定制会 sync+compose，终端仓仅 clone/pull
# 分支约定：主仓 / 专业包 / 定制包 / 终端仓一律 develop（禁止配置 main）
# PRO_ENABLED=0
# PRO_REPO_URL=https://gitee.com/kuaigeyun/kuaigeyun-pro.git
# PRO_REPO_PATH=
# PRO_GIT_BRANCH=develop
# PRO_GIT_TOKEN=
# WORKSPACE_COMPOSE_MODE=copy
# CUSTOM_ENABLED=0
# CUSTOM_REPO_URL=https://gitee.com/kuaigeyun/kuaigeyun-custom.git
# CUSTOM_REPO_PATH=
# CUSTOM_GIT_BRANCH=develop
# CUSTOM_GIT_TOKEN=
# 定制项目 id（逗号分隔，须存在于定制仓 projects/registry.yaml；CUSTOM_ENABLED=1 时必填）
# 交互菜单：A=全装（逗号拼接 registry 全部项），1/2/…=选装单项；新增 registry 项后序号自动递增
# 单客户：CUSTOM_PROJECTS=haoligo  或  CUSTOM_PROJECTS=funide-oa
# 开发机全装：CUSTOM_PROJECTS=haoligo,funide-oa
# CLIENT_ENABLED=0
# CLIENT_REPO_URL=https://gitee.com/kuaigeyun/kuaigeyun-client.git
# CLIENT_REPO_PATH=
# CLIENT_GIT_BRANCH=develop
# CLIENT_GIT_TOKEN=

# ----- 后端选装能力（默认 0=不装包/不装系统库/迁移与启动不强制；按需改为 1）-----
# 升级自旧版且仍用发票 OCR、PDF 打印、KU-AI 向量或敏感词过滤时，请把对应项设为 1。
# OPT_INVOICE_OCR=0      # 发票 PDF 二维码/OCR（uv --extra ocr + Linux zbar/libGL）
# OPT_PDF_PRINT=0        # 打印 PDF（uv --extra pdf + Playwright Chromium）
# OPT_KUAI_VECTOR=0      # KU-AI 向量检索（PostgreSQL pgvector + 迁移 vector 列）
# OPT_SENSITIVE_LEXICON=0 # 敏感词词库 lexicon.pack（组织开启敏感词控制时需要）
# OPT_LIBREOFFICE=0      # LibreOffice（Word/PPT 转 PDF 高级预览；未装则简易预览。Excel 走 Univer Sheet）

# 兼容字段：启用 OPT_PDF_PRINT 时会自动写为 1；Chromium 是否安装只看 OPT_PDF_PRINT
PLAYWRIGHT_POSTINSTALL_ENABLE=1

# Chromium 浏览器二进制目录（默认项目根 .playwright-browsers，避免 ~/.cache 被清理或 sudo/用户不一致导致丢失）
# PLAYWRIGHT_BROWSERS_PATH=

# 宿主平台覆盖（可选，一般不用设）。部署脚本会读 /etc/os-release + Playwright 版本自动选择：
#   Ubuntu <22 → ubuntu22.04-*；26.04 且 Playwright<1.61 → ubuntu24.04-*；≥28 → 最近支持的 LTS。
# 仅当自动探测不对时再手动指定，例如：PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64
# PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=

# 国内 PyPI：默认清华（apply_cn_mirrors）；sync 失败再回退阿里云/官方，成功源写回 UV_INDEX_URL。
# 迁移用 uv run --no-sync。生产机建议钉死：
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
# 或：UV_INDEX_URL=https://pypi.org/simple/
# UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 客户端安装包/OTA 静态文件根目录（Caddy 直出；默认 riveredge-backend/uploads/clients）
# CLIENT_RELEASE_ROOT=
# 后端 FILE_UPLOAD_DIR 对应目录（遗留 mobile-apk 直出；默认 CLIENT_RELEASE_ROOT 的上级 uploads）
# FILE_UPLOAD_ROOT=

# ----- KU-Bridge WorkBuddy MCP（方案 B：主站 /mcp 反代 Sidecar）-----
# prod update/start 会自动：生成 Caddy /mcp 反代、启动 Sidecar（需 PRO_REPO_PATH + workbuddy-mcp.env）
# 填全 workbuddy-mcp.env 且已设 CADDY_DOMAIN 时，即使未写 ENABLE 也会自动 WORKBUDDY_MCP_ENABLE=1
# WORKBUDDY_MCP_ENABLE=0
# WORKBUDDY_MCP_PORT=8765
# WORKBUDDY_MCP_ENV_FILE=  # 默认 fast-deploy/config/workbuddy-mcp.env
