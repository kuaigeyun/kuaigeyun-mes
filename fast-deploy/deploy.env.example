# RiverEdge fast-deploy 部署层配置
# 复制为 deploy.env 后按需修改：cp deploy.env.example deploy.env

# 后端 API 端口（Caddy 反代目标）
BACKEND_PORT=8200

# 前端开发端口（仅 dev 模式）
FRONTEND_PORT=8100

# Caddy 对外监听端口（生产模式，无域名时监听 :PROXY_PORT）
PROXY_PORT=8080

# 生产域名（留空则使用 :PROXY_PORT）
CADDY_DOMAIN=

# 是否启用 Let's Encrypt（需填写域名且 80 端口可从公网访问）
CADDY_ENABLE_LETSENCRYPT=false

# Node 构建堆内存（MB）
NODE_BUILD_MEM=4096

# 服务器 IP（configure 向导写入，用于 BASE_URL 与局域网访问提示）
SERVER_IP=
