# RiverEdge Caddy 配置模板（由 fast-deploy 脚本渲染）
# 占位符：{{ADDR}} {{BACKEND_ADDR}} {{FRONTEND_ROOT}} {{MOBILE_WEB_ROOT}} {{CLIENT_RELEASE_ROOT}} {{FILE_UPLOAD_ROOT}}
# 实际生成文件：fast-deploy/caddy/Caddyfile

# 管理 API 使用 2018，避免与系统 Caddy 默认 2019 冲突；供 caddy reload 热加载
{
	admin 127.0.0.1:2018
}

# 地址: {{ADDR}}
{{ADDR}} {
    encode gzip zstd

    # 发票 AI 解析/复核等长耗时接口：须写在通用 /api/* 之前。
    # 复杂票 DeepSeek 往返常超过默认 response_header_timeout 30s，会表现为 504。
    @api_long_running path \
        /api/v1/apps/haoligo/finance/invoices/parse-pdf \
        /api/v1/apps/haoligo/finance/invoices/ai-review \
        /api/v1/apps/kuaizhizao/sales-orders/ocr-extract
    handle @api_long_running {
        reverse_proxy {{BACKEND_ADDR}} {
            transport http {
                read_timeout 300s
                write_timeout 300s
                response_header_timeout 300s
                keepalive 30s
            }
        }
    }

    handle /api/* {
        reverse_proxy {{BACKEND_ADDR}} {
            transport http {
                read_timeout 60s
                write_timeout 60s
                response_header_timeout 30s
                keepalive 30s
            }
        }
    }
    # handle_path 自动剥离 URL 前缀，与后端 StaticFiles 挂载路径一致（clients/{key}/packages/...）
    handle_path /static/client-packages/* {
        root * {{CLIENT_RELEASE_ROOT}}
        file_server
    }
    handle_path /static/client-updates/* {
        root * {{CLIENT_RELEASE_ROOT}}
        file_server
    }
    handle_path /static/mobile-apk/* {
        root * {{FILE_UPLOAD_ROOT}}/mobile/apk
        file_server
    }
    handle_path /static/mobile-updates/* {
        root * {{FILE_UPLOAD_ROOT}}/mobile/updates
        file_server
    }
    handle /static/* {
        reverse_proxy {{BACKEND_ADDR}} {
            transport http {
                read_timeout 60s
                write_timeout 60s
                response_header_timeout 30s
                keepalive 30s
            }
        }
    }
    handle /docs* {
        reverse_proxy {{BACKEND_ADDR}} {
            transport http {
                read_timeout 60s
                write_timeout 60s
                response_header_timeout 30s
                keepalive 30s
            }
        }
    }
    handle /redoc* {
        reverse_proxy {{BACKEND_ADDR}} {
            transport http {
                read_timeout 60s
                write_timeout 60s
                response_header_timeout 30s
                keepalive 30s
            }
        }
    }
    handle /openapi.json {
        reverse_proxy {{BACKEND_ADDR}} {
            transport http {
                read_timeout 60s
                write_timeout 60s
                response_header_timeout 30s
                keepalive 30s
            }
        }
    }
    handle /health {
        reverse_proxy {{BACKEND_ADDR}} {
            transport http {
                read_timeout 60s
                write_timeout 60s
                response_header_timeout 30s
                keepalive 30s
            }
        }
    }

    # 旧企微 H5 /m/* → Expo Web /mobile/*（永久重定向，保留 query）
    @m_equip_scan path /m/kuaizhizao/equipment/scan
    redir @m_equip_scan /mobile/equipment/scan?{query} permanent

    @m_equip_spot_checks path /m/kuaizhizao/equipment/spot-checks
    redir @m_equip_spot_checks /mobile/equipment/spot-checks?{query} permanent

    @m_equip_faults path /m/kuaizhizao/equipment/faults
    redir @m_equip_faults /mobile/equipment/faults?{query} permanent

    @m_equip_maint_reminders path /m/kuaizhizao/equipment/maintenance-reminders
    redir @m_equip_maint_reminders /mobile/equipment/maintenance-reminders?{query} permanent

    @m_equip_spot_check_legacy path /m/kuaizhizao/equipment/spot-check
    redir @m_equip_spot_check_legacy /mobile/equipment/spot-check-conduct?{query} permanent

    @m_equip_uuid_spot path_regexp m_uuid_spot ^/m/kuaizhizao/equipment/([0-9a-fA-F-]{36})/spot-check/?$
    redir @m_equip_uuid_spot /mobile/equipment/spot-check-conduct?uuid={re.m_uuid_spot.1}&{query} permanent

    @m_equip_uuid_fault path_regexp m_uuid_fault ^/m/kuaizhizao/equipment/([0-9a-fA-F-]{36})/fault/?$
    redir @m_equip_uuid_fault /mobile/equipment/faults?uuid={re.m_uuid_fault.1}&{query} permanent

    @m_equip_uuid_status path_regexp m_uuid_status ^/m/kuaizhizao/equipment/([0-9a-fA-F-]{36})/status/?$
    redir @m_equip_uuid_status /mobile/equipment/detail?uuid={re.m_uuid_status.1}&{query} permanent

    @m_equip_uuid path_regexp m_uuid ^/m/kuaizhizao/equipment/([0-9a-fA-F-]{36})/?$
    redir @m_equip_uuid /mobile/equipment/detail?uuid={re.m_uuid.1}&{query} permanent

    @m_equip_root path /m/kuaizhizao/equipment /m/kuaizhizao/equipment/
    redir @m_equip_root /mobile/equipment/scan?{query} permanent

    handle /m/* {
        redir * /mobile?{query} permanent
    }

    # Expo Web（riveredge-app/mobile web-dist，baseUrl=/mobile）
    # 注意：handle /mobile 是前缀匹配，会吃掉 /mobile/*；必须用 path 精确匹配再 308
    @mobile_exact path /mobile
    redir @mobile_exact /mobile/ 308
    handle_path /mobile/* {
        root * {{MOBILE_WEB_ROOT}}
        try_files {path} /index.html
        file_server
        header Cache-Control "no-cache"
    }

    # 登录 MPA：独立 login.html，避免 /login 落入主 SPA 而 preload 整包 vendor
    @login_mpa path /login /login/
    handle @login_mpa {
        root * {{FRONTEND_ROOT}}
        rewrite * /login.html
        file_server
        header Cache-Control "no-cache"
    }
    handle /login.html {
        root * {{FRONTEND_ROOT}}
        file_server
        header Cache-Control "no-cache"
    }

    handle {
        root * {{FRONTEND_ROOT}}
        try_files {path} /index.html
        file_server
        header /assets/* Cache-Control "public, max-age=31536000, immutable"
        header / Cache-Control "no-cache"
        header /index.html Cache-Control "no-cache"
    }
}
