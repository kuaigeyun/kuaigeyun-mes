[Unit]
Description=RiverEdge Taskiq Worker
After=network-online.target postgresql.service riveredge-backend.service
Wants=postgresql.service
PartOf=riveredge.service

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
WorkingDirectory={{PROJECT_ROOT}}
Environment=HOME={{SERVICE_HOME}}
Environment=PLAYWRIGHT_BROWSERS_PATH={{PLAYWRIGHT_BROWSERS_PATH}}
Environment=RIVEREDGE_SYSTEMD=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:{{SERVICE_HOME}}/.local/bin:{{SERVICE_HOME}}/.cargo/bin
Environment=RIVEREDGE_UV={{UV_BIN}}
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=131072
StandardOutput=journal
StandardError=journal
ExecStart={{TASKIQ_WORKER_EXEC_SCRIPT}}
Restart=always
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=riveredge.service
