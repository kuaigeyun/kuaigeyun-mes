# 复制为 e2e/.env 后填写（e2e/.env 已被 gitignore，勿提交密码）

# 前端 dev 地址（与 vite 默认一致）
E2E_BASE_URL=http://127.0.0.1:8100

# 后端 API 根地址（不经 vite 代理，globalSetup 直连登录）
E2E_API_ORIGIN=http://127.0.0.1:8200

# 测试账号（建议专用租户管理员，已安装 快制造 + 快财务 + 主数据）
E2E_USERNAME=admin
E2E_PASSWORD=change-me

# 多组织账号必填；单组织可留空
# E2E_TENANT_ID=1
